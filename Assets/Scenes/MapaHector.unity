  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Soy sombra que en la mente mora,\r\nvestigio de lo que ya fue.\r\nMe escondo
    tras una hora\r\nque jam\xE1s volver\xE1s a ver.\r\n\r\nNo soy consuelo ni abrigo,\r\nsoy
    herida sin cerrar.\r\nAun as\xED, camino contigo\u2026\r\nPues negarme es no
    sanar.\r\n\r\n\xBFQue es lo que hace que el pasado\r\nno se pierda por mucho
    que el tiempo quiera?\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f1b52e4b20b2ee14391c7f1bfa1ab2f9, type: 2}
  m_sharedMaterial: {fileID: 9156436250022122069, guid: f1b52e4b20b2ee14391c7f1bfa1ab2f9, type: 2}
